<?xml version="1.0" encoding="utf-8"?>
<!-- One track in the library: its place in the list, title and artist, length on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/row_bg"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <TextView
        android:id="@+id/trackIndex"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.08"
        android:textColor="#FF8A8AA8"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="1"
            android:textColor="#FF3E3E5C"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/trackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:maxLines="1"
            android:textColor="#FF6B6B8A"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/trackDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.06"
        android:textColor="#FF6B6B8A"
        android:textSize="14sp" />
</LinearLayout>
