<?xml version="1.0" encoding="utf-8"?>
<!-- The whole app: the launcher's teal header over its wallpaper, then the now-playing card and the
     library, both on the same white panels with a navy edge. Built for a 1080p TV at ~1 dp/px. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fallback">

    <!-- The launcher's wallpaper, copied into this app's folder at install; the gradient above shows
         through while it is missing. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The turquoise band, as on Home: lozenge, title and subtitle, the actions on the right. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#FF00CCBB"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_diamond" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.18"
                    android:text="@string/header_title"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/outfit_light"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true"
                    android:textColor="#F2FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/refresh"
                style="@style/Chip"
                android:text="@string/refresh" />

            <TextView
                android:id="@+id/night"
                style="@style/Chip"
                android:text="@string/night_mode" />

            <TextView
                android:id="@+id/quit"
                style="@style/Chip"
                android:text="@string/quit" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_diamond" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingTop="28dp"
            android:paddingEnd="56dp"
            android:paddingBottom="36dp">

            <!-- EN LECTURE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.44"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/Kicker"
                    android:text="@string/now_playing" />

                <!-- The record sits in whatever height the text leaves, so the card fits whatever
                     density the TV reports instead of pushing the controls out of the panel. Its
                     square is fixed: a shape drawable is stretched to its view, so a match_parent
                     view in a short slot would flatten the disc into an oval. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/disc"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/disc_cd"
                        android:src="@drawable/disc" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:text="@string/nothing_playing"
                    android:textColor="#FF3E3E5C"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/nowArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_regular"
                    android:maxLines="1"
                    android:textColor="#FF545179"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:maxHeight="14dp"
                    android:minHeight="14dp"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:progressDrawable="@drawable/seek_bar"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nowPosition"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.06"
                        android:text="0:00"
                        android:textColor="#FF6B6B8A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/nowDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.06"
                        android:text="0:00"
                        android:textColor="#FF6B6B8A"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/previous"
                        style="@style/RoundButton"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:contentDescription="@string/previous_cd"
                        android:padding="12dp"
                        android:src="@drawable/ic_prev" />

                    <ImageView
                        android:id="@+id/playPause"
                        style="@style/RoundButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/play_cd"
                        android:padding="14dp"
                        android:src="@drawable/ic_play" />

                    <ImageView
                        android:id="@+id/next"
                        style="@style/RoundButton"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:contentDescription="@string/next_cd"
                        android:padding="12dp"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/backTen"
                        style="@style/Chip"
                        android:layout_height="36dp"
                        android:text="@string/back_ten"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/forwardTen"
                        style="@style/Chip"
                        android:layout_height="36dp"
                        android:text="@string/forward_ten"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- MA BIBLIOTHÈQUE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="26dp"
                android:layout_weight="0.56"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kicker"
                        android:text="@string/library" />

                    <TextView
                        android:id="@+id/libraryCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="end"
                        android:letterSpacing="0.14"
                        android:textColor="#FF8A8AA8"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trackList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:scrollbars="none" />

                    <!-- Shown instead of the list until there is something to play. -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/panel_soft"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="26dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_medium"
                            android:text="@string/empty_title"
                            android:textAllCaps="true"
                            android:textColor="#FF3E3E5C"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/emptyBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/outfit_regular"
                            android:lineSpacingExtra="7dp"
                            android:textColor="#FF545179"
                            android:textSize="15sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shuffle"
                        style="@style/Chip"
                        android:text="@string/shuffle" />

                    <TextView
                        android:id="@+id/repeat"
                        style="@style/Chip"
                        android:text="@string/repeat_all" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- MODE NUIT: a black sheet over everything, with the TV's brightness taken down to nothing,
         so the screen does not light the room while a track plays. Any key (or a click) lifts it. -->
    <FrameLayout
        android:id="@+id/nightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/nightHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/outfit_light"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:text="@string/night_hint"
            android:textAllCaps="true"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>

</FrameLayout>
