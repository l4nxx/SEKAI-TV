<?xml version="1.0" encoding="utf-8"?>
<!-- The record in the EN LECTURE card, drawn rather than shipped as a bitmap: a navy disc, a teal
     outer ring, two pale grooves and a teal spindle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF23233A" />
            <stroke
                android:width="3dp"
                android:color="#FF00CCBB" />
        </shape>
    </item>
    <item
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="#FF2B2B47" />
            <stroke
                android:width="1dp"
                android:color="#FF545179" />
        </shape>
    </item>
    <item
        android:bottom="34dp"
        android:left="34dp"
        android:right="34dp"
        android:top="34dp">
        <shape android:shape="oval">
            <solid android:color="#FF1E1E32" />
            <stroke
                android:width="1dp"
                android:color="#FF6C6C93" />
        </shape>
    </item>
    <item
        android:bottom="62dp"
        android:left="62dp"
        android:right="62dp"
        android:top="62dp">
        <shape android:shape="oval">
            <solid android:color="#FF00CCBB" />
        </shape>
    </item>
</layer-list>
