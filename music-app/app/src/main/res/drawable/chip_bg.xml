<?xml version="1.0" encoding="utf-8"?>
<!-- A pill from the launcher's top bar: white with a navy edge, teal and a thick navy edge when
     focused, dimmed white when it is off (a transport or shuffle button that is not engaged). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke
                android:width="4dp"
                android:color="#FF3E3E5C" />
            <corners android:radius="29dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF00CCBB" />
            <stroke
                android:width="2dp"
                android:color="#FF3E3E5C" />
            <corners android:radius="29dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#FF545179" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</selector>
