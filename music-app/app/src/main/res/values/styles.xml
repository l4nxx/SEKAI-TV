<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvMusic" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The launcher's pill: white panel, navy edge, thick navy edge while focused. -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@drawable/chip_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- A transport button: the same pill, square and round, with a 26dp icon inside. -->
    <style name="RoundButton">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- The one line above a card's content: small, spaced, navy. -->
    <style name="Kicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FF3E3E5C</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.24</item>
    </style>
</resources>
