<?xml version="1.0" encoding="utf-8"?>
<!-- Opens AllAppsActivity as the dock bar growing upwards: the page window starts at the dock's
     width and height, pinned to the bottom edge, and scales to the full screen. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:duration="360"
        android:fromXScale="0.90"
        android:fromYScale="0.17"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="100%"
        android:interpolator="@android:interpolator/decelerate_quint" />
</set>
