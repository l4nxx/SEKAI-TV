<?xml version="1.0" encoding="utf-8"?>
<!-- The Theme tab's window: a small white card in the middle of the screen, on a dimmed Home.
     Same panels, navy type and teal accent as the rest of the launcher. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="660dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/theme_dialog_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/theme_dialog_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/themeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.14"
                android:singleLine="true"
                android:text="@string/theme_settings"
                android:textAllCaps="true"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnCredits"
                style="@style/TopButton"
                android:layout_height="36dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/credits"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/themeClose"
                style="@style/TopButton"
                android:layout_height="40dp"
                android:layout_marginStart="0dp"
                android:text="@string/all_apps_close"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:textSize="13sp"
                android:drawableStart="@drawable/ic_chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:text="@string/theme_language"
                android:textAllCaps="true"
                android:textColor="#FF3E3E5C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/themeCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@string/font_medium"
                android:singleLine="true"
                android:textColor="#FF3E3E5C"
                android:textSize="15sp" />

            <ScrollView
                android:id="@+id/themeScroll"
                android:layout_width="match_parent"
                android:layout_height="306dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="18dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/themeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.2"
                android:text="@string/music"
                android:textAllCaps="true"
                android:textColor="#993E3E5C"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/musicOff"
                style="@style/TopButton"
                android:layout_height="34dp"
                android:layout_marginStart="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/music_off"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/music20"
                style="@style/TopButton"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="20 %"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/music40"
                style="@style/TopButton"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="40 %"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/music60"
                style="@style/TopButton"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="60 %"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
