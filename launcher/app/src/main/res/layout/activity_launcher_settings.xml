<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's settings page, in the theme's look: the teal band of Home, white panels with a navy
     edge, navy type in capitals. The first panel carries the TV's own settings pages, the second the
     launcher's layout and motion choices. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF070B1D"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="#FF00CCBB"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="40dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_band_diamond" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.16"
            android:singleLine="true"
            android:text="@string/settings"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/btnSettingsClose"
            style="@style/TopButton"
            android:text="@string/all_apps_close" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="26dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_band_diamond" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="24dp"
        android:overScrollMode="never"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="26dp"
        android:paddingBottom="30dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/theme_dialog_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/wifiChoice"
                    style="@style/SettingsRow"
                    android:text="@string/quick_network" />

                <TextView
                    android:id="@+id/appsChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="4dp"
                    android:text="@string/quick_apps" />

                <TextView
                    android:id="@+id/displayChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="4dp"
                    android:text="@string/quick_picture" />

                <TextView
                    android:id="@+id/tvSettingsChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="4dp"
                    android:text="@string/tv_settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/theme_dialog_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/reorderChoice"
                    style="@style/SettingsRow"
                    android:text="@string/reorder"
                    android:visibility="gone" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/columns_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/rows_below_dock_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/dock_opacity_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                    <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                    <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                    <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wallpaperChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/animationsChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/advancedChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="4dp" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/advanced_effects_warning" />

                <TextView
                    android:id="@+id/openOnStartChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="18dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/followThemeChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="18dp"
                    android:text="@string/follow_theme" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/follow_theme_hint" />

                <TextView
                    android:id="@+id/defaultHomeChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="18dp"
                    android:text="@string/home_settings" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/home_settings_help" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
