<?xml version="1.0" encoding="utf-8"?>
<!-- The Credits card, opened from the theme window and stacked over it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/theme_dialog_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/theme_dialog_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.14"
                android:singleLine="true"
                android:text="@string/credits"
                android:textAllCaps="true"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/creditsClose"
                style="@style/TopButton"
                android:layout_height="38dp"
                android:layout_marginStart="0dp"
                android:drawableStart="@drawable/ic_chevron_down"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="@string/all_apps_close"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.2"
                android:text="@string/credits_game"
                android:textAllCaps="true"
                android:textColor="#993E3E5C"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@string/font_medium"
                android:text="Project Sekai COLORFUL STAGE!"
                android:textColor="#FF3E3E5C"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="feat. Hatsune Miku · © SEGA / Colorful Palette"
                android:textColor="#B33E3E5C"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.2"
                android:text="@string/credits_launcher"
                android:textAllCaps="true"
                android:textColor="#993E3E5C"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@string/font_medium"
                android:text="CleanYourTV — Gathin"
                android:textColor="#FF3E3E5C"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="MIT License · github.com/Gathin23/cleanyourtv"
                android:textColor="#B33E3E5C"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.2"
                android:text="@string/credits_font"
                android:textAllCaps="true"
                android:textColor="#993E3E5C"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@string/font_medium"
                android:text="Outfit — SIL Open Font License 1.1"
                android:textColor="#FF3E3E5C"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#263E3E5C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/credits_disclaimer"
                android:textColor="#993E3E5C"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
